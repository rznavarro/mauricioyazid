# URL canónica del sitio (sin barra final). En Vercel, si no se define, se usa el dominio
# de producción del proyecto (VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: WhatsApp en formato internacional, sin "+" ni espacios (ej.: 56912345678).
# Si no se define, los botones "Escríbeme" abren el mensaje directo de Instagram.
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# Cuestionario interno (/cuestionario): envío de respuestas por correo con Resend (solo servidor).
# RESEND_API_KEY=
# CUESTIONARIO_DESTINO=           # correo que recibe las respuestas (el de la cuenta de Resend)
# CUESTIONARIO_REMITENTE=         # opcional; por defecto "Cuestionario web <onboarding@resend.dev>"
